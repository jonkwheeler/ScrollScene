{
  "name": "scrollscene",
  "title": "ScrollScene",
  "version": "0.0.25",
  "description": "ScrollScene is an extra layer on top of ScrollMagic as well as using IntersectionObserver to achieve similar effects.",
  "author": "Jon K. Wheeler",
  "license": "MIT",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/commonjs/index.js",
      "types": "./dist/commonjs/index.d.ts"
    },
    "./observer": {
      "import": "./dist/esm/observer.js",
      "require": "./dist/commonjs/observer.js",
      "types": "./dist/commonjs/observer.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": ["**/debug.addIndicators.*", "**/scrollmagic-add-indicators.*", "./src/index.ts", "./src/index.js"],
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "shamefullyHoist": true,
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "react-draggable": "4.4.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonkwheeler/ScrollScene.git"
  },
  "publishConfig": {
    "scope": "jonkwheeler",
    "registry": "https://registry.npmjs.org/"
  },
  "config": {
    "dirBuild": "./dist",
    "dirCommonjs": "./dist/commonjs",
    "dirEsm": "./dist/esm",
    "dirSrc": "./src",
    "dirStorybook": "./.storybook",
    "dirStorybookBuild": "./public",
    "portStorybook": "8888"
  },
  "scripts": {
    "build:commonjs": "pnpm run nuke:commonjs && cross-env BABEL_ENV=commonjs babel $npm_package_config_dirSrc --out-dir $npm_package_config_dirCommonjs --extensions \".ts,.tsx,.js,.jsx\" --ignore \"**/*.stories.js\",\"**/*.stories.jsx\",\"**/*.stories.ts\",\"**/*.stories.tsx\",\"**/story.js\",\"**/stories\",\"**/*.test.js\",\"test.js\",\"**/test\",\"**/*.md\",\"**/*.mdx\",\"**/docs\" --source-maps",
    "build:esm": "pnpm run nuke:esm && cross-env BABEL_ENV=esm babel $npm_package_config_dirSrc --out-dir $npm_package_config_dirEsm --extensions \".ts,.tsx,.js,.jsx\" --ignore \"**/*.stories.js\",\"**/*.stories.jsx\",\"**/*.stories.ts\",\"**/*.stories.tsx\",\"**/story.js\",\"**/stories\",\"**/*.test.js\",\"test.js\",\"**/test\",\"**/*.md\",\"**/*.mdx\",\"**/docs\" --source-maps",
    "build:package": "pnpm run build:commonjs && pnpm run build:esm && pnpm run build:types",
    "build:storybook": "storybook build -o $npm_package_config_dirStorybookBuild",
    "build:types:commonjs": "tsc --project tsconfig.types.cjs.json && tsconfig-replace-paths --project tsconfig.types.cjs.json",
    "build:types:esm": "tsc --project tsconfig.types.esm.json && tsconfig-replace-paths --project tsconfig.types.esm.json",
    "build:types": "pnpm run build:types:commonjs && pnpm run build:types:esm",
    "build": "pnpm run build:storybook",
    "dev": "pnpm run start:storybook",
    "lint": "eslint .",
    "nuke:all:install:dev": "pnpm run nuke:all && pnpm install && pnpm run dev",
    "nuke:all:install": "pnpm run nuke:all && pnpm install",
    "nuke:all": "rm -rf node_modules .cache $npm_package_config_dirBuild pnpm-lock.yaml yarn.lock yarn-error.log package-lock.json",
    "nuke:build:rebuild": "pnpm run nuke:build && pnpm run build:package",
    "nuke:build": "rm -rf $npm_package_config_dirBuild",
    "nuke:commonjs": "rm -rf $npm_package_config_dirBuild",
    "nuke:esm": "rm -rf $npm_package_config_dirEsm",
    "prepublishOnly": "pnpm run nuke:build:rebuild",
    "release": "pnpm exec release-it",
    "start:storybook": "storybook dev -p $npm_package_config_portStorybook -c $npm_package_config_dirStorybook",
    "storybook": "pnpm run start:storybook"
  },
  "dependencies": {
    "@babel/runtime": "^7.8.4",
    "is-client": "^0.0.2",
    "lodash.throttle": "^4.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.7.7",
    "@babel/core": "^7.7.7",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-proposal-export-default-from": "^7.7.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.7.7",
    "@babel/plugin-transform-runtime": "^7.8.3",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.7.4",
    "@babel/preset-typescript": "^7.7.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-eslint": "^10.0.3",
    "babel-plugin-add-react-displayname": "^0.0.5",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^4.0.0",
    "core-js": "^3.37.1",
    "cross-env": "^6.0.3",
    "eslint": "^6.8.0",
    "eslint-plugin-react": "^7.17.0",
    "gsap": "^3.0.4",
    "normalize.css": "^8.0.1",
    "prettier": "^1.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^12.4.3",
    "scrollmagic": "^2.0.7",
    "storybook": "^10.5.7",
    "tsconfig-replace-paths": "^0.0.5",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-eslint-rules": "^5.4.0",
    "types-installer": "^1.6.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "peerDependencies": {
    "scrollmagic": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "scrollmagic": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/jonkwheeler/ScrollScene/issues"
  },
  "homepage": "https://github.com/jonkwheeler/ScrollScene#readme",
  "keywords": [
    "scrollmagic",
    "scroll",
    "scrollscene",
    "gsap",
    "greensock"
  ],
  "packageManager": "pnpm@9.15.9"
}
